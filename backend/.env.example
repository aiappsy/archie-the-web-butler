# ── Google Gemini (AI parser) ──────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Firebase / Firestore ───────────────────────────────────────────────────
# Option A: path to a downloaded service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# Option B: when running on GCP/Cloud Run, Application Default Credentials
#           are picked up automatically – leave GOOGLE_APPLICATION_CREDENTIALS unset.

# ── Canva Connect API ──────────────────────────────────────────────────────
CANVA_ACCESS_TOKEN=your_canva_access_token_here

# ── Webflow Data API v2 ────────────────────────────────────────────────────
WEBFLOW_API_TOKEN=your_webflow_api_token_here

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000
